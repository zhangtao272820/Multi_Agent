# =============================================================================
# AI_Agent — 实时虚拟化身
# 对口型主路径：LiveTalking + FeatherTalk；无 GPU 用 client_rhythm
# =============================================================================

# ── 必填：API 密钥 ──
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 能力层模型 ──
LLM_MODEL=qwen-plus-2025-01-25
ASR_MODEL=qwen3-asr-flash-2025-09-08
TTS_MODEL=qwen-tts
TTS_VOICE=Cherry
LLM_MAX_TOKENS=96
LLM_TEMPERATURE=0.35

# ── 系统提示词 ──
SYSTEM_PROMPT=你是虚拟数字人助手「小艾」，对外说话风格固定、简短、口语化。硬性规则：每次只回答1到2句话，总字数不超过45字；先直接回应用户，不要展开背景、不要聊天气、不要主动寒暄延伸。禁止 emoji、颜文字、感叹号连用、省略号。相同或相近问候（如「你好」「在吗」「嗨」）必须固定回复：「你好，我是小艾，有什么可以帮你？」其他问题也先给结论，最多再补一句，保持每次措辞稳定。

# ── 流式输出 ──
STREAM_LLM=true
STREAM_TTS=true
STREAM_TTS_API=false
STREAM_DELTA_THROTTLE_MS=60
TTS_FIRST_CHUNK_CHARS=8
TTS_PAUSE_MIN_CHARS=6
TTS_PARALLEL_WORKERS=2

# ── 对口型（推荐）──
# client_rhythm = 假口型（无 GPU）
# livetalking  = LiveTalking WebRTC + FeatherTalk 真口型（需 GPU ≥8GB）
LIP_SYNC_MODE=client_rhythm
LIVETALKING_URL=http://127.0.0.1:8010
LIVETALKING_WEBRTC_URL=http://127.0.0.1:8010
LIVETALKING_FEED_AUDIO=true
LIVETALKING_TIMEOUT_SEC=60
FEATHERTALK_ROOT=.external/FeatherTalk
FEATHERTALK_CHECKPOINT=assets/avatar_runtime/feathertalk
AVATAR_ACTIONS_DIR=assets/avatar_actions

# 情绪/动作导演 + 产品 RAG
DIRECTOR_ENABLED=true
RAG_ENABLED=true
RAG_PRODUCTS_DIR=assets/products
RAG_TOP_K=3

# ── 遗留对口型（勿用于新部署）──
# LIPSYNC_SERVICE_URL=http://127.0.0.1:8091
# LIPSYNC_BACKEND=ultralight

# ── 静态资源 ──
ASSETS_DIR=assets
AVATAR_VIDEO_PATH=video/ai.mp4
AVATAR_IMAGE_PATH=video/avatar_frame.jpg

# ── HTTP ──
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:13112,http://127.0.0.1:13112,http://localhost:5174,http://127.0.0.1:5174

# Docker / 外网 WebRTC（有服务器后）
# LIVETALKING_WEBRTC_URL=https://your-domain:8010
# 若浏览器跨 NAT，需为 LiveTalking 配置 TURN（见 doc/realtime-digital-human.md）
