# =============================================================================
# AI_admin_Agent — 办公自动化 Agent（邮件/日历/天气等）
# 复制为 backend/.env 后填写 DASHSCOPE_API_KEY
# 能力层模型 SSOT：Manage-platform_Agent/.env.capability-models.example
# =============================================================================

# ── 必填：API 密钥 ──
DASHSCOPE_API_KEY=your_dashscope_api_key # 阿里云百炼 API Key

# ── HTTP 服务 ──
PORT=8000                                # 监听端口（集群标准 13105，见 docker-compose）
HOST=0.0.0.0                             # 监听地址
CORS_ORIGINS=http://localhost:5173       # 允许的前端源（多个逗号分隔）

# ── 能力层模型 ──
MODEL_NAME=qwen-flash-2025-07-28         # T0 办公自动化对话模型
MAX_TOKENS_PER_REQUEST=2000              # 单次请求 token 上限
MAX_TOKENS_PER_SESSION=10000             # 单会话累计 token 上限
TIMEZONE=Asia/Shanghai                   # 日程/邮件时间显示时区
WORKSPACE_DIR=                           # 工作区目录（空=默认 backend 下 workspace）
ADMIN_DATA_DIR=                          # 持久化目录（SQLite/偏好/进化；Docker: /app/data）

# ── 邮件 SMTP（发信，可选）──
SMTP_SERVER=smtp.qq.com                  # SMTP 服务器
SMTP_PORT=465                            # SMTP 端口（SSL 常用 465）
SMTP_USER=                               # 发信邮箱账号
SMTP_PASS=                               # 发信邮箱授权码/密码

# ── 邮件 IMAP（收信，可选；公网请改用按用户绑定）──
IMAP_SERVER=imap.qq.com                  # IMAP 服务器
IMAP_PORT=993                            # IMAP 端口
IMAP_USER=                               # 收信邮箱账号
IMAP_PASS=                               # 收信邮箱授权码/密码
# 按用户绑定国内邮箱（Fernet 密文）；公网默认关闭全局 .env 回退
ADMIN_MAIL_FERNET_KEY=                   # Fernet key 或任意长密钥（推荐 openssl rand -base64 32）
ADMIN_MAIL_ALLOW_GLOBAL_FALLBACK=0       # 1=本地可回退 SMTP_*/IMAP_*；公网保持 0

# ── 天气（和风天气：须在控制台复制专属 API Host）──
WEATHER_API_KEY=your_qweather_api_key
# 控制台 → 设置 → API Host，形如 https://abc1234xyz.def.qweatherapi.com（勿用 devapi/geoapi 公共域名）
WEATHER_API_HOST=
WEATHER_CACHE_TTL_SECONDS=900           # 天气缓存 TTL（秒）
WEATHER_RATE_LIMIT_SECONDS=60           # 同地点请求最小间隔（秒）

# ── NLU 理解（推荐 ADMIN_NLU_MODE=full）──
ADMIN_NLU_MODE=full                      # full | legacy | fast（NLU 管线 + 闲聊快路径）
# 意图 Playbook/经验「向量召回」默认关（省 embedding token；场景靠意图 LLM）
# 与 knowledge_retrieval→RAG_Agent 知识库无关。显式开启：ADMIN_INTENT_RAG=1
ADMIN_INTENT_RAG=0
ADMIN_INTENT_RAG_FAST_MIN_SCORE=0.68
# OPENAI_API_KEY=                        # 与 DASHSCOPE 二选一，供 embedding
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-v1
# ADMIN_EMBEDDING_TIMEOUT_SEC=12

# ── 记忆与 Playbook（skills/*.md 规则文本，不是向量 RAG）──
ADMIN_MEMORY_MODE=standard               # standard | minimal | off
ADMIN_DIALOGUE_MAX_TURNS=10

# ── 知识库检索工具（可选调用 RAG_Agent，非意图路由）──
RAG_AGENT_URL=http://127.0.0.1:13102    # RAG_Agent HTTP 地址（与 Manager RAG_AGENT_HTTP_URL 一致）
RAG_RETRIEVE_TIMEOUT_SECONDS=25
RAG_SKIP_EVIDENCE_SELECT=0              # 1=跳过 evidence LLM 选择（更快）
ADMIN_SEARCH_PROVIDER=auto              # auto | searxng | duckduckgo | mock | none
ADMIN_SEARCH_MOCK=0                     # 1=强制 mock 搜索（仅调试）
SEARXNG_BASE_URL=http://127.0.0.1:8088  # Docker LAN: http://searxng:8080
SEARXNG_LANGUAGE=zh-CN
WEB_SEARCH_ALLOW_DDG_FALLBACK=1         # SearXNG 失败时回退 DuckDuckGo
WEB_SEARCH_TIMEOUT_SECONDS=15
MANAGER_POLICY_DIR=                     # 总管用户画像 JSON 目录（默认 ../Manager_Agent/.data）

# ── 内部鉴权（与 RAG/Manager 对齐，LAN 部署建议配置）──
# CLAWHIVE_INTERNAL_TOKEN=

# ── 自我进化 ──
ADMIN_EVOLUTION_MODE=convergence         # convergence | off（NLU/工具措辞进化，不改场景路由）
EVO_MODE=convergence
ARTIFACT_FEEDBACK_MODE=strict
ADMIN_PROMOTE_MIN_HITS=3

# ── 玩法台（MCP 趣味八件套 Phase 1）──
# MINERU_API_URL=http://mineru_api:8080   # Phase3/K：文档重解析侧车（RAG 与 Admin 共用）
# MINERU_ENGINE=auto                     # auto|full|enhanced|lite
# ADMIN_MCP_GATEWAY_URL=http://admin_mcp_gateway:8790
# ADMIN_MCP_ENABLED=1             # fun-mcp profile 启用侧车时设为 1
# ADMIN_MCP_SERVERS=              # 见 Manage-platform_Agent/docker/admin-mcp-servers.example.json（单行 JSON）
# PLAYGROUND_HTTP_UA=             # 热榜/B站 请求 User-Agent（可选）

# ── 外部集成（批次 3）──
# ADMIN_MCP_URL=http://127.0.0.1:8765/mcp
# ADMIN_WEBHOOK_URL=                  # 提醒/通知 Webhook（企业微信/钉钉/自定义）
# ADMIN_WEBHOOK_FORMAT=generic        # generic | wecom | dingtalk
# ADMIN_LANGGRAPH_CHECKPOINTER=0      # memory | postgres | 0=关（Phase5 PostgresSaver）
# ADMIN_STORAGE_BACKEND=postgres      # sqlite | postgres（会话 turn/task_context）
# AGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/clawhive
# ADM_TOOL_EXPERIENCE_REQUIRE_FEEDBACK=1   # P0：仅 confirmed 工具路径参与召回
# ADMIN_CALENDAR_ICS_URL=             # 可选默认 ICS 订阅（webcal/http）

# ── 国内扩展（批次 4）──
DB_AGENT_HTTP_URL=http://127.0.0.1:13101   # DB_Agent HTTP（Docker: http://db_agent:13101）
DB_AGENT_DB_ID=default
DB_ASK_TIMEOUT_SECONDS=60
# ADMIN_WECOM_WEBHOOK_URL=            # 企业微信群机器人（可与 ADMIN_WEBHOOK_URL 二选一）
# ADMIN_DINGTALK_WEBHOOK_URL=         # 钉钉群机器人
# ADMIN_WEBHOOK_FORMAT=wecom          # generic | wecom | dingtalk

# ── 批次 5：自动化 / 出行 / 飞书 ──
# LOBSTER_AGENT_HTTP_URL=http://127.0.0.1:13108
# LOBSTER_POLL_MAX_SECONDS=90
# ADMIN_AMAP_KEY=                     # 高德 Web 服务 Key
# ADMIN_AMAP_CITY=北京
# ADMIN_FEISHU_ICS_URL=               # 飞书日历 → 设置 → 日历订阅 ICS 链接

# ── 批次 6：集成清单 / 飞书机器人 / 多日历 ──
# ADMIN_FEISHU_WEBHOOK_URL=           # 飞书群自定义机器人 Webhook
# ADMIN_CALENDAR_SUBSCRIPTIONS=       # JSON：{"feishu":"http://...","work":"webcal://..."}
# ADMIN_FEISHU_MCP_URL=               # 可选：飞书 MCP HTTP 侧车（需 ADMIN_MCP_ENABLED=1）
# 集成状态 API：GET /api/integrations

# =============================================================================
# LLM-First 生产建议（doc/llm-first-cross-agent-upgrade.md §13.6）
# 能力层 / MODE：Manage-platform_Agent/.env.capability-models + .env.convergence-modes.example
# =============================================================================
ADMIN_NLU_MODE=full                      # full=LLM+Zod slots+plan fastpath；legacy=词表调试
# WEATHER_API_HOST=                      # 和风专属 API Host（必填，勿用公共 devapi）
