# Campus Agent — copy to .env (dev) or %LOCALAPPDATA%\CampusAgent\.env (desktop)
DASHSCOPE_API_KEY=
# Optional alias
# CAMPUS_API_KEY=

CAMPUS_LLM_MODEL=qwen-flash-character
CAMPUS_AUX_LLM_MODEL=qwen-plus

# Optional overrides
# CAMPUS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CAMPUS_PORT=0
# CAMPUS_WEBVIEW_DEBUG=1
