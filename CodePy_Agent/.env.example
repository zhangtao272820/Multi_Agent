# CodePy_Agent — lean code agent (replaces Nuxt code_assistent in compose)
# Copy to .env. Prefer OPENAI_* (兼容旧 Code)；也可用 QWEN_*。

OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# T2 代码/compute 可用 coder；compose 也可注入 CAP_REASON / CAP_ROUTE
OPENAI_MODEL=qwen-coder-plus

# 兼容别名
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=
# CAP_ROUTE=qwen-turbo

QWEN_ENABLE_THINKING=off
CAP_ENABLE_THINKING=off
AGENT_LLM_JSON_MAX_TOKENS=896

CODE_PORT=13103
HOST=0.0.0.0

# 工程根（Docker 栈挂载 monorepo → /workspace）
PROJECT_DIR=.
ALLOWED_ROOTS=.

# 写盘闸门（独立端确认写 + 服务端校验）
WRITE_TOOL_ENABLED=0
CODE_MCP_SERVER=1
CODE_EDIT_MAX_ROUNDS=8
CODE_MAX_FILE_CHARS=120000

# CLAWHIVE_INTERNAL_TOKEN=
