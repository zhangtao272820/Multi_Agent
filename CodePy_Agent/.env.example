# CodePy_Agent — lean code agent (replaces Nuxt code_assistent in compose)
# Copy to .env. Prefer OPENAI_* (兼容旧 Code)；也可用 QWEN_*。
# 能力层 SSOT：Manage-platform_Agent/.env.capability-models
#   OPENAI_MODEL / QWEN_MODEL ← CAP_CODER (T2)
#   OPENAI_EMBEDDING_MODEL ← CAP_EMBEDDING (E0)
# 同步：Manage-platform_Agent/scripts/sync-capability-models.ps1 -Agents CodePy_Agent

OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-coder-plus
OPENAI_EMBEDDING_MODEL=text-embedding-v1
QWEN_MODEL=qwen3-coder-plus

QWEN_ENABLE_THINKING=off
CAP_ENABLE_THINKING=off
AGENT_LLM_JSON_MAX_TOKENS=896

CODE_PORT=13103
HOST=0.0.0.0

# 工程根（Docker 栈挂载 monorepo → /workspace）
PROJECT_DIR=.
ALLOWED_ROOTS=.

# 写盘闸门（独立端确认写 + 服务端校验）
WRITE_TOOL_ENABLED=0
CODE_MCP_SERVER=1
CODE_EDIT_MAX_ROUNDS=8
CODE_MAX_FILE_CHARS=120000

# CLAWHIVE_INTERNAL_TOKEN=
