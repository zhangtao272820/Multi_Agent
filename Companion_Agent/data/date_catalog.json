          "bg": "cafe_evening"
        },
        {
          "text": "窗外天色慢慢暗了。她把菜单往你这边推。",
          "voice": "narration",
          "sprite": {
            "outfit": "date",
            "emotion": "happy"
          },
          "bg": "cafe_evening"
        },
        {
          "text": "你点吧。我想听你说话多一点。",
          "voice": "heroine",
          "sprite": {
            "outfit": "date",
            "emotion": "shy"
          },
          "bg": "cafe_evening"
        }
