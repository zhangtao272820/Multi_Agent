            "outfit": "casual",
            "emotion": "neutral"
          },
          "bg": "cafe"
        },
        {
          "text": "她看了眼手机：还有二十分钟。够吗？",
          "voice": "narration",
          "sprite": {
            "outfit": "casual",
            "emotion": "shy"
          },
          "bg": "cafe"
        },
        {
          "text": "够。快点吃，也快点说正事。",
          "voice": "heroine",
          "sprite": {
            "outfit": "casual",
            "emotion": "happy"
          },
          "bg": "cafe"
        }
      ]
