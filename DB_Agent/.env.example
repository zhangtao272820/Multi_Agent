# =============================================================================
# DB_Agent — 自然语言查数 Agent
# 复制为 .env 后填写 OPENAI_API_KEY、MYSQL_PASSWORD
# 行为默认 → utils/db_agent_env.ts · MODE SSOT → .env.convergence-modes.example
# 模型 SSOT → Manage-platform_Agent/backend/app/capability_models.py
# =============================================================================

# ── 必填（勿提交 git）──
OPENAI_API_KEY=                          # 阿里云百炼 API Key
MYSQL_PASSWORD=                          # MySQL 密码
MYSQL_DATABASE=p2026                      # 目标数据库名

# ── 能力层模型（与 capability_models.py DEFAULT_CAPABILITY_MODELS 一致）──
OPENAI_ORCHESTRATION_MODEL=qwen3.5-flash            # T0 route
OPENAI_NLU_MODEL=qwen3.5-flash                      # T0 route
OPENAI_AGENT_MODEL=qwen3-coder-flash-2025-07-28           # T2 coder
OPENAI_COMPLEX_MODEL=qwen3-coder-plus             # 复杂 Schema/SQL；不配则同 AGENT_MODEL
EMBEDDING_MODEL=text-embedding-v1                 # E0 embedding
EMBEDDING_DIMENSIONS=1536

# ── 运行档位（推荐只改这一块）──
DB_AGENT_DOMAIN=p2026                    # 域标识 → data/domains/<domain>/（别名：AGENT_DOMAIN）
DB_AGENT_PROFILE=balanced                # balanced | low_token | full
DB_ROUTE_MODE=schema_first               # schema_first | legacy（优先于已废弃 ENABLE_SCHEMA_FIRST_ROUTE）
DB_LEGACY_SHORTCUTS=off                  # off | on（域 Skill / 指标硬编码捷径）
DB_NLU_MODE=full                         # full | minimal | off（NLU 管线）
EVO_MODE=convergence                     # convergence | learning | off
ARTIFACT_FEEDBACK_MODE=strict            # strict | off（SQL 模板学习门控）
QWEN_ENABLE_THINKING=off

# ── 可选调优（一般不必改）──
DB_QUERY_SLOT_SCHEMA_REFINE=auto               # auto | on | off
DB_SCHEMA_LINK_STRUCTURAL_MIN_SCORE=42
ENABLE_EXPLAIN_PREFLIGHT=on
ENABLE_SQL_TEMPLATE_DIRECT=on
SCHEMA_CACHE_TTL_SEC=300
AGENT_FALLBACK_ONLY_ON_HARD_FAIL=on      # 仅 SQL 硬错误才进 ReAct

# ── 记忆存储 ──
# AGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/clawhive
# DB_AGENT_STORAGE_BACKEND=postgres      # file | postgres | dual

# ── ClawHive / 跨 Agent（Docker AGENT_BROWSER_AUTH=1 时必填）──
# 未配置 CLAWHIVE_INTERNAL_TOKEN 时，Manager 预取 POST /api/plan 会 401 login_required
# CLAWHIVE_BACKEND_URL=http://127.0.0.1:18000
# CLAWHIVE_INTERNAL_TOKEN=                    # 与 Manager / .env.agents-lan 同值
# AGENT_BROWSER_AUTH=1
# JWT_SECRET=change-this-secret

# =============================================================================
# LLM-First 生产建议（doc/llm-first-cross-agent-upgrade.md §13.6）
# 能力层 / MODE：Manage-platform_Agent/.env.capability-models + .env.convergence-modes.example
# =============================================================================
# DB_NLU_MODE=full                       # 槽位/意图 LLM；balanced profile 已关 structural plan
# DB_AGENT_PROFILE=balanced
# DB_LEGACY_SHORTCUTS=off
