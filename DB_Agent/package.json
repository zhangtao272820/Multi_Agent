{
  "name": "db-agent",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "vue-tsc --noEmit",
    "seed:p2026-person": "node scripts/seed-p2026-person.mjs",
    "postinstall": "nuxt prepare",
    "smoke:metrics": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-metrics.ts",
    "smoke:slot-ssot": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-slot-ssot.ts",
    "smoke:person": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-person-basic-stats.ts",
    "smoke:person-info-a5": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-person-info-a5-path.ts",
    "smoke:nlu": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-db-nlu.ts",
    "smoke:query-plan-prompt-packs": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-query-plan-prompt-packs.ts",
    "smoke:decompose": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-decompose-regression.ts",
    "smoke:structural-link": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-structural-link.ts",
    "smoke:ws-thinking": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-ws-thinking-sender.ts",
    "smoke:sql-path": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-sql-path.ts",
    "smoke:error-code": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-error-code-contract.ts",
    "smoke:nlu-mode": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-db-nlu-mode.ts",
    "smoke:domain-modules": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-domain-modules.ts",
    "smoke:split-exports": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-split-exports.ts",
    "smoke:all": "npm run smoke:metrics && npm run smoke:slot-ssot && npm run smoke:person && npm run smoke:nlu && npm run smoke:nlu-mode && npm run smoke:query-plan-prompt-packs && npm run smoke:sql-path && npm run smoke:error-code && npm run smoke:domain-modules && npm run smoke:split-exports && npm run smoke:ws-thinking && npm run gate:nl2sql",
    "eval:golden": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/eval-golden-person-basic-stats.ts",
    "gate:nl2sql": "node scripts/gate-db-nl2sql-offline.mjs && npm run eval:golden"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.23",
    "@langchain/core": "^1.1.32",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/openai": "^1.2.13",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "langchain": "^1.2.31",
    "mysql2": "^3.14.4",
    "nuxt": "^4.3.1",
    "pg": "^8.21.0",
    "three": "^0.183.2",
    "typeorm": "^0.3.27",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  }
}
