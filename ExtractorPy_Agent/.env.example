# ExtractorPy_Agent — lean crawler (replaces Node Extractor in compose)
# Copy to .env and set QWEN_API_KEY
# 能力层 SSOT：Manage-platform_Agent/.env.capability-models（T0 CAP_ROUTE）

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 抽取只用 T0 路由档，勿用 CAP_REASON / plus（省 token）
# Compose 注入：QWEN_MODEL=${CAP_ROUTE}；本机可直接写 CAP_ROUTE 或 QWEN_MODEL
CAP_ROUTE=qwen-turbo
QWEN_MODEL=qwen-turbo
CAP_ENABLE_THINKING=off
QWEN_ENABLE_THINKING=off

# JSON 抽取输出上限（与平台 AGENT_LLM_JSON_MAX_TOKENS 对齐）
AGENT_LLM_JSON_MAX_TOKENS=512
EXTRACTOR_PLAN_MAX_TOKENS=384
EXTRACTOR_TASK_MAX_CHARS=2000
# 送入 LLM 的正文：页数 × 每页字符（启发式失败才调 LLM）
EXTRACTOR_LLM_MAX_PAGES=3
EXTRACTOR_LLM_PAGE_CHARS=1200

CRAWLER_PORT=13104
HOST=0.0.0.0

# Standalone UI / open discovery seeds
EXTRACTOR_WEB_SEARCH=1
SEARXNG_BASE_URL=http://127.0.0.1:8088
SEARXNG_TIMEOUT_MS=25000
EXTRACTOR_WEB_SEARCH_MAX_SEEDS=6

# Firecrawl-compatible CRW (compose: http://crw:3000/v1/scrape)
MCP_PROVIDER=firecrawl
MCP_API_KEY=local
MCP_BASE_URL=http://127.0.0.1:13114/v1/scrape
MCP_RENDER=on
EXTRACTOR_MCP_MAX_CALLS=12

# Self-hosted Playwright MCP (compose: http://playwright_mcp:8931/mcp)
PLAYWRIGHT_MCP_ENABLED=1
PLAYWRIGHT_MCP_URL=http://127.0.0.1:18931/mcp

EXTRACTOR_ASYNC_QUEUE=1
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_DEFAULT_MAX_ITEMS=20
CRAWLER_DEFAULT_MAX_PAGES=5

# CLAWHIVE_INTERNAL_TOKEN=
