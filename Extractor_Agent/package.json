    "@types/three": "^0.183.1",
    "@types/turndown": "^5.0.6",
    "bullmq": "^5.78.0",
    "bullmq": "^5.58.5",
    "cheerio": "^1.1.2",
    "ioredis": "^5.8.1",
    "ioredis": "^5.11.1",
    "nuxt": "^4.4.2",
    "openai": "^4.104.0",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "three": "^0.183.2",
    "turndown": "^7.2.2",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "zod": "^3.25.76"
  }
