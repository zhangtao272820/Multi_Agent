{
  "name": "extractor-agent",
  "type": "module",
  "private": true,
  "imports": {
    "#agent-shared/*": "./agent-repo-shared/*"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "smoke": "node scripts/extractor-smoke.mjs",
    "smoke:prompt-packs": "npx --yes tsx scripts/smoke-extractor-prompt-packs.ts",
    "smoke:strict": "node scripts/extractor-smoke.mjs --strict",
    "plan:check": "node scripts/structural-plan-check.mjs",
    "eval:extractor": "node scripts/extractor-eval.mjs",
    "eval:extractor:baseline": "node scripts/extractor-eval.mjs --write-baseline",
