    "eval:e2e": "node scripts/manager-extractor-e2e.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/openai": "^1.2.13",
