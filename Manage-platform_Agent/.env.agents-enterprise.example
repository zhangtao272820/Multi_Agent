# =============================================================================
# ClawHive 企业生产安全档（覆盖 LAN 默认）— 示例，勿提交真实密钥
#
# 推荐用法（详见 docs/企业化.md）：
#   1) Copy-Item .env.agents-enterprise.example .env.agents-enterprise
#   2) 对齐 .env.agents-lan 中的 CLAWHIVE_INTERNAL_TOKEN / JWT_SECRET / MANAGER_WS_TOKEN
#   3) .\scripts\restart-agents-lan.ps1 -Enterprise
#
# 或不加 -Enterprise：把下列键合并进 .env.agents-lan 后 recreate。
# 回退：去掉本文件或 AGENT_SECURITY_PROFILE=enterprise 后再 recreate（禁 down -v）。
# =============================================================================

# 一键档位：服务鉴权 require + Manager WS token + 租户 fail-closed
AGENT_SECURITY_PROFILE=enterprise

# 可显式写出（与档位一致；单项优先于档位）
AGENT_SERVICE_AUTH=require
MANAGER_AUTH_MODE=token
MGR_TENANT_FAIL_CLOSED=1
MGR_TENANT_SCOPE=1

# 入口限流（0=不限；企业建议 30–120）。LAN 默认不设本文件则保持 0。
MANAGER_REQUEST_RATE_PER_MIN=60
MANAGER_MAX_INFLIGHT_RUNS=8
MANAGER_MAX_INFLIGHT_PER_EXPERT=2

# 用户 JWT（须与平台 JWT_SECRET 一致；claim 必须含 tenant_id）
AGENT_BROWSER_AUTH=1
MANAGER_USER_AUTH=1

# 与 .env.agents-lan 保持同一非空值（此处仅作提醒；密钥放 lan 或本文件均可）
# CLAWHIVE_INTERNAL_TOKEN=
# MANAGER_WS_TOKEN=
# JWT_SECRET=

# 熔断（run 内 streak 已有；全局降级仅运维显式打开，默认不要设）
# MANAGER_SERVICE_DEGRADE_LEVEL=0
MANAGER_AGENT_CIRCUIT_STREAK=2
MANAGER_CIRCUIT_SKIP_CORE=1

# 注入 / 内容信任：enterprise 默认严档（更短 untrusted 截断）；显式 0 可关
MANAGER_CONTENT_TRUST_STRICT=1
# PII 落盘 / Observation 更短截断（不改用户可见正文默认）
MANAGER_PII_POLICY=enterprise
# SLI 成本估算（Prometheus manager_sli_estimated_usd）
MANAGER_COST_PER_1K_TOKENS_USD=0.002

# Docker 双轨：日常不加 -Enterprise；启用见 doc/enterprise-docker.md
# 验收：.\scripts\verify-enterprise-docker.ps1（契约 smoke，不调 LLM）
