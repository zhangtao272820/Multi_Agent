# =============================================================================
# ClawHive Docker LAN — 集群叠加配置（复制为 .env.agents-lan，勿提交密钥）
# MODE SSOT：.env.convergence-modes + sync-convergence-modes.py
# 模型 SSOT：.env.capability-models + sync-capability-models.py
# 鉴权契约：Manager_Agent/.env.example（S1）· 生产硬度：docs/Agent集群升级与面试对照.md
# 公网演示：docs/公网演示部署.md · docker/public/Caddyfile.example
# =============================================================================

# ── 主机可达地址（install-linux.sh 必填）──
# 局域网：填本机 LAN IP（如 192.168.1.10）
# 公网演示：填公网 IP 或域名（如 demo.example.com）；经 Caddy HTTPS 后仍填该主机名
LAN_HOST=请填写公网IP或域名

# ── 模型 Key（至少填一组；install-linux.sh 校验）──
# OPENAI_API_KEY=
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=

# ── 对外端口（宿主机映射；公网只经 80/443 反代，勿把下列端口写进安全组）──
CLAWHIVE_FRONTEND_PORT=18073
CLAWHIVE_BACKEND_PORT=18000
DB_PORT=13101
RAG_PORT=13102
CODE_PORT=13103
CRAWLER_PORT=13104
AI_ADMIN_PORT=13105
MANAGER_PORT=13106
MULTIMODAL_PORT=13107
RAG_PG_PORT=15433

# ── RAG L 波（compose 已有默认；可在此覆盖）──
# RAG_ENABLE_HYDE=0
# RAG_ENABLE_POLICY_GRAPH=1
# RAG_RRF_GRAPH_WEIGHT=1.15
# RAG_POLICY_GRAPH_BACKEND=auto
# RAG_ENABLE_MULTI_QUERY=0

# ── ClawHive 平台 ──
CLAWHIVE_INTERNAL_TOKEN=change-internal-token
CLAWHIVE_ADMIN_USERNAME=admin
CLAWHIVE_ADMIN_PASSWORD=admin123
# CORS：公网请加上 https://chat.你的域名,https://ops.你的域名
CLAWHIVE_ALLOW_ORIGINS=http://localhost:5173,http://localhost:18073,http://127.0.0.1:18073,http://localhost:18000,http://127.0.0.1:18000
# 可选：Alertmanager 外发 webhook（企微/钉钉机器人或自定义 URL）；空则仅通知控制台
# CLAWHIVE_ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# CP-G3：密钥 Fernet at-rest（rotate 写回 sealed_ciphertext）；非真 KMS
# CLAWHIVE_VAULT_KEY=change-me-to-a-long-random-string
# CP-G4：备份建议保留份数（维护页展示；人工清理）
CLAWHIVE_BACKUP_RETAIN_COUNT=14
CLAWHIVE_PG_USER=postgres
CLAWHIVE_PG_PASSWORD=postgres
CLAWHIVE_PG_DB=clawhive
CLAWHIVE_PG_PORT=15432
CLAWHIVE_REDIS_PORT=16379

# ── 统一登录（1A Agent UI；userId = JWT.sub = username）──
# 契约：docs/unified-login.md · compose 注入 JWT_SECRET / AGENT_BROWSER_AUTH / MANAGER_USER_AUTH
CLAWHIVE_JWT_SECRET=change-this-secret
AGENT_BROWSER_AUTH=1
MANAGER_USER_AUTH=1
NUXT_PUBLIC_MANAGER_USER_AUTH=1
# 浏览器可达；容器内登录转发用 compose 的 CLAWHIVE_BACKEND_URL=http://clawhive_backend:8000
# 公网经反代时改为 https://ops.你的域名 或后端公开 URL（见 docs/公网演示部署.md）
CLAWHIVE_PUBLIC_URL=http://127.0.0.1:18000
NUXT_PUBLIC_CLAWHIVE_AUTH_URL=http://127.0.0.1:18000
# 开启登录前的无主会话/记忆归属用户；一次性迁移：
#   Get-Content .\scripts\migrate-legacy-owner-to-admin.sql -Raw | docker exec -i clawhive_postgres psql -U postgres -d clawhive
MANAGER_LEGACY_OWNER_USER=admin

# ── Manager MODE（sync 脚本会同步到各 Agent .env）──
EVO_MODE=convergence
ARTIFACT_FEEDBACK_MODE=strict
MANAGER_ROUTE_MODE=convergence
MANAGER_PRO_MODE=strong
MANAGER_WEB_SEARCH_MODE=open
MANAGER_PLATFORM_MODE=sync
MANAGER_AUTH_MODE=token
MANAGER_RUNTIME=docker
QWEN_ENABLE_THINKING=off
MANAGER_INTENT_RAG_TOP_K=2

# ── Manager 调优（原 compose C 类，改这里即可，无需动 compose）──
AGENT_TIMEOUT_MS=240000
MANAGER_DOCKER_TIMEOUT_MS=240000
MANAGER_LLM_REQUEST_TIMEOUT_MS=120000
MANAGER_LLM_MAX_RETRIES=0
AGENT_LLM_REQUEST_TIMEOUT_MS=120000
AGENT_LLM_MAX_RETRIES=0
AGENT_LLM_JSON_MAX_TOKENS=2048
AGENT_LLM_SYNTH_MAX_TOKENS=2048
MANAGER_DOCKER_LATENCY_MUL=1.2
MANAGER_RAG_SKIP_EVIDENCE_SELECT=1
MANAGER_RAG_PREFETCH_TIMEOUT_MS=30000
MANAGER_DB_PREFETCH_TIMEOUT_MS=45000
MANAGER_ORCHESTRATOR_SKIP_RAG_RECALL=1
MANAGER_RAG_PREFETCH_SKIP_RETRIEVE_ON_MISS=0
MANAGER_DB_PROBE_HINTS_LLM=0
MANAGER_RAG_PROBE_TIMEOUT_MS=20000
MANAGER_INTERNAL_AGENT_TIMEOUT_MS=45000
MANAGER_INTERNAL_AGENT_TIMEOUT_MAX_MS=90000
MANAGER_INTERNAL_DEADLINE_RESERVE_MS=50000
MANAGER_CLEAN_ALIGN_TIMEOUT_MS=25000
MANAGER_PIPELINE_HINTS_LLM=0
MANAGER_CLAUSE_DECOMPOSE=0
MANAGER_STEP_SANITIZE_LLM=0
MANAGER_TASK_STACK_LLM_EXTRACT=0
MANAGER_TASK_STACK_LLM_EXTRACT_ON_FINALIZE=0
MANAGER_PARALLEL_INDEPENDENT=1
MANAGER_PREFETCH_DB_PLAN=1
MANAGER_STREAM_DELTA=1
MANAGER_GUI_HTTP_POLL=0
MANAGER_MUSIC_HTTP_POLL=1
MANAGER_CRAWLER_HTTP_ASYNC=1
MANAGER_OTEL_EXPORT=1
MANAGER_OTEL_TRACEPARENT=1

# ── 安全与重试预算（硬上限，防无限重试耗 token；与 Manager_Agent/.env.example 同步）──
# 决策表：docs/公网演示部署.md §「专家失败决策」· 备战 06 §7.2a
MANAGER_LOCAL_REPLAN_MAX=3
MANAGER_MAX_RETRY=1
MANAGER_GRAPH_RECURSION_LIMIT=48
MANAGER_MAX_RUN_PHASES=3
MANAGER_PHASE_STEP_BUDGET=8
MANAGER_AUTONOMOUS_MAX_STEPS=8
MANAGER_AUTONOMOUS_MAX_ATTEMPTS=2
# MANAGER_LLM_MAX_RETRIES 见上方调优段（默认 0）
MANAGER_AGENT_CIRCUIT_STREAK=2
MANAGER_CIRCUIT_SKIP_CORE=1
# 专家 HTTP 传输重试：仅可恢复 5xx；timeout/业务错不重试（clamp 0–2）
MANAGER_EXPERT_TRANSPORT_RETRIES=1
# 单 run 成本硬顶（0/未设=不限；公网演示务必设正数，防刷爆 API）
MANAGER_RUN_MAX_TOKENS=200000
# MANAGER_RUN_MAX_USD=1.5
# G2 背压：并发 run / 每专家 inflight（未设则不限；公网建议开启）
MANAGER_MAX_INFLIGHT_RUNS=8
MANAGER_MAX_INFLIGHT_PER_EXPERT=4
# Prompt 分块软/硬预算（字符；system 超限仅 warn，不 silent 砍规则）
MANAGER_PROMPT_BUDGET_SYSTEM_CHARS=4500
MANAGER_PROMPT_BUDGET_RULES_CHARS=2000
MANAGER_PROMPT_BUDGET_SKILL_CHARS=2500
MANAGER_OBS_SUMMARY_MAX_CHARS=400
MANAGER_OBS_KEEP_LAST=4
MANAGER_HANDOFF_SUMMARY_MAX_CHARS=600
# 进化门禁见下方 EVO_VERIFY_BEFORE_PROMOTE / EVO_PROMOTE_REQUIRES_VERIFY（须保持 1）

# ── Manager 持久化 / 特性（MGR_* / EVO_*）──
MANAGER_STORAGE_BACKEND=postgres
MANAGER_LANGGRAPH_CHECKPOINTER=postgres
MANAGER_CHECKPOINT_BACKEND=dual
REDIS_URL=redis://clawhive_redis:6379/0
MGR_CHECKPOINTER_AUTO=1
MGR_TOOL_CALL_AUDIT=1
MGR_PROCESS_MEMORY=1
MGR_FEDERATION_REQUIRE_FEEDBACK=1
MGR_CODE_EXPERIENCE_SYNC=1
MGR_CRAWLER_EXPERIENCE_SYNC=1
MGR_GUI_EXPERIENCE_SYNC=1
MANAGER_DUAL_MODEL_QA=1
MGR_MCP_REGISTRY=1
MGR_ONLINE_EVAL=1
EVO_ONLINE_EVAL_GATE=1
MGR_TOOL_CALL_POLICY=1
MGR_KG_MEMORY=1
MGR_TENANT_SCOPE=1
MANAGER_VECTOR_BACKEND=pgvector
MANAGER_CONVERSATION_LLM_SUMMARIZE=1
EVO_VERIFY_BEFORE_PROMOTE=1
EVO_ROUTE_MATRIX_GATE=1
EVO_AGENT_PROMPT_EXECUTION_ONLY=1
EVO_PROMOTE_REQUIRES_VERIFY=1
EVO_AUDIT_JOB=1
MGR_SESSION_ARCHIVE_JOB=1
LANGSMITH_TRACING=false
MANAGER_DB_ID=p2026
# ── 联网 ──
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_TIMEOUT_MS=25000
WEB_SEARCH_ALLOW_DDG_FALLBACK=0

# ── WS / 运维鉴权（与 Manager_Agent/.env.example S1 成对；AUTH_MODE=token 时必填）──
MANAGER_WS_TOKEN=change-internal-token
NUXT_PUBLIC_MANAGER_WS_TOKEN=change-internal-token
# 运维 POST /api/manager/ops（头 x-manager-ops-token）；未设则一律 403
MANAGER_OPS_TOKEN=change-ops-token

# ── Lobster VNC（勿用 6080：Windows Hyper-V 常占用 6078–6177）──
LOBSTER_PORT=13108
LOBSTER_VNC_PORT=18088
LOBSTER_RAW_VNC_PORT=15900
