# =============================================================================
# Manage-platform_Agent backend — ClawHive 治理平台
# 复制为 backend/.env；Docker 全家桶以 .env.agents-lan 为准
# =============================================================================

# ── 部署模式 ──
DEPLOY_MODE=local                        # local | docker
AGENT_CONTROL_MODE=docker                # docker=控制台启停 compose | process=本机进程
COMPOSE_FILE_PATH=e:\Agent\Manage-platform_Agent\docker-compose.agents-lan.yml
COMPOSE_ENV_FILE_PATH=e:\Agent\Manage-platform_Agent\.env.agents-lan

# ── 必填：LLM 密钥 ──
QWEN_API_KEY=                            # 阿里云百炼 API Key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 能力层模型（本机 backend；Docker 以 .env.capability-models + apply 为准）──
QWEN_MODEL=qwen-plus-2025-09-11          # 默认模型（T1）
QWEN_PLANNER_MODEL=qwen3.5-flash-2026-02-23 # 规划/路由（T0）
QWEN_EXECUTOR_MODEL=qwen-plus-2025-09-11 # 执行/综合（T1）
# QWEN_TEMPERATURE=0.2                   # LLM 温度

# ── 数据库与缓存 ──
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/clawhive  # PostgreSQL 连接串
REDIS_URL=redis://localhost:6379/0       # Redis 连接串

# ── 鉴权 ──
JWT_SECRET=change-this-secret            # JWT 签名密钥（生产务必修改；与 CLAWHIVE_JWT_SECRET / 各 Agent 一致）
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=480
# 各 Agent UI 本地登录：POST /api/auth/login；验签 GET /api/auth/validate；userId=JWT.sub
ADMIN_USERNAME=admin                     # 控制台管理员账号
ADMIN_PASSWORD=admin123                  # 控制台管理员密码（生产务必修改）

# ── 工作区 ──
WORKSPACE_ROOT=e:\Agent                  # Agent 仓库根目录
RUNTIME_ROOT=.local\runtime              # 运行时数据目录

# ── 内部 API 令牌（与 Manager_Agent/.env 中 CLAWHIVE_INTERNAL_TOKEN 必须相同）──
CLAWHIVE_INTERNAL_TOKEN=change-internal-token

# ── 本机 Agent 探活地址（Docker 内由 compose 注入 *_AGENT_HOST 服务名）──
DB_AGENT_HOST=localhost
RAG_AGENT_HOST=localhost
CODE_AGENT_HOST=localhost
EXTRACTOR_AGENT_HOST=localhost
AI_ADMIN_AGENT_HOST=localhost
MANAGER_AGENT_HOST=localhost
MULTIMODAL_AGENT_HOST=localhost
LOBSTER_AGENT_HOST=localhost
TAVERN_AGENT_HOST=localhost
VIDEO_AGENT_HOST=localhost
AI_AGENT_HOST=localhost

# ── HTTP ──
ALLOW_ORIGINS=http://localhost:5173,http://localhost:18073,http://127.0.0.1:18073  # CORS 允许源

# ── 任务重试 ──
# MAX_TASK_RETRIES=2
