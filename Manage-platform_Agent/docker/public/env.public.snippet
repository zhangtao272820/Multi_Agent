# 公网演示时，把下列键合并进 .env.agents-lan（替换域名与密钥后启用）
# 完整步骤：docs/公网演示部署.md
# 弱机一键：bash scripts/install-linux.sh --core --enterprise --public --no-monitor

LAN_HOST=demo.example.com
CLAWHIVE_PUBLIC_URL=https://ops.example.com
NUXT_PUBLIC_CLAWHIVE_AUTH_URL=https://ops.example.com
CLAWHIVE_ALLOW_ORIGINS=https://chat.example.com,https://ops.example.com

# 以下必须改成 openssl rand -hex 24 一类随机值，勿提交真实密钥
# CLAWHIVE_INTERNAL_TOKEN=
# MANAGER_WS_TOKEN=
# NUXT_PUBLIC_MANAGER_WS_TOKEN=
# MANAGER_OPS_TOKEN=
# CLAWHIVE_JWT_SECRET=
# CLAWHIVE_ADMIN_PASSWORD=
# CLAWHIVE_PG_PASSWORD=
# OPENAI_API_KEY=   # 或 QWEN_API_KEY / DASHSCOPE_API_KEY

# ── 公网必开：会话退出 / 成本 / 背压（与企业档叠加）──
AGENT_SECURITY_PROFILE=enterprise
AGENT_SERVICE_AUTH=require
MGR_TENANT_FAIL_CLOSED=1
MGR_TENANT_SCOPE=1
MANAGER_AUTH_MODE=token
AGENT_BROWSER_AUTH=1
MANAGER_USER_AUTH=1
MANAGER_DISABLED_AGENTS=music,video,gui
MANAGER_MAX_RETRY=1
MANAGER_EXPERT_TRANSPORT_RETRIES=1
MANAGER_AGENT_CIRCUIT_STREAK=2
MANAGER_CIRCUIT_SKIP_CORE=1
MANAGER_AUTONOMOUS_MAX_STEPS=8
MANAGER_GRAPH_RECURSION_LIMIT=48
# 4C8G 建议 80000；更大机器可调到 200000
MANAGER_RUN_MAX_TOKENS=80000
MANAGER_MAX_INFLIGHT_RUNS=3
MANAGER_MAX_INFLIGHT_PER_EXPERT=1
MANAGER_REQUEST_RATE_PER_MIN=60
MANAGER_COST_PER_1K_TOKENS_USD=0.002
MANAGER_CONTENT_TRUST_STRICT=1
MANAGER_PII_POLICY=enterprise
MANAGER_PROMPT_AUTO_PROMOTE=0
EVO_VERIFY_BEFORE_PROMOTE=1
EVO_PROMOTE_REQUIRES_VERIFY=1
EVO_ALLOW_EXPERT_AUTO_PROMOTE=0
