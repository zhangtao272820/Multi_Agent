# =============================================================================
# Manager_Agent — 总管路由/编排 Agent
# 复制为 .env 后填写 OPENAI_API_KEY
# MODE SSOT：Manage-platform_Agent/.env.convergence-modes.example
# 生产硬度 / 下一波守门：docs/Agent集群升级与面试对照.md
# 能力主轴（已收口）：docs/Agent矩阵升级总路线图.md
# 解析：server/utils/platform/managerEnvModes.ts · npm run smoke:env-modes
# =============================================================================

# ── 必填：API 密钥 ──
OPENAI_API_KEY=                          # 阿里云百炼 API Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-flash-2025-07-28       # 默认回退模型
OPENAI_EMBEDDING_MODEL=text-embedding-v1
QWEN_ENABLE_THINKING=off

# ── 分阶段模型（未设则回退 OPENAI_MODEL）──
MANAGER_MODEL_ROUTE=qwen-plus-2025-01-25         # T1 路由/编排
MANAGER_MODEL_ROUTE_MAX=qwen-max-latest          # MANAGER_ROUTE_DECISION_TIER=max 时用
MANAGER_MODEL_PLAN=qwen-plus-2025-01-25
MANAGER_MODEL_SYNTH=qwen-plus-2025-01-25
MANAGER_MODEL_CRITIC=qwen-flash-2025-07-28
MANAGER_MODEL_LOW_COST=qwen-flash-2025-07-28
MANAGER_MODEL_CLEAN=qwen-flash-2025-07-28
MANAGER_MODEL_VISUALIZE=qwen-flash-2025-07-28
MANAGER_MODEL_REPORT=qwen-flash-2025-07-28
MANAGER_RAG_JUDGE_MODEL=qwen-flash-2025-07-28
AGENT_LLM_JSON_MAX_TOKENS=2048

# ── 子 Agent 连接（MANAGER_RUNTIME=docker 用服务名；local 见下方注释）──
DB_AGENT_WS_URL=ws://db_agent:13101/api/chat.ws
DB_AGENT_HTTP_URL=http://db_agent:13101
RAG_AGENT_HTTP_URL=http://rag_agent:13102
CODE_AGENT_WS_URL=ws://code_assistent_agent:13103/_ws
CRAWLER_AGENT_WS_URL=ws://extractor_agent:13104/_ws
CRAWLER_AGENT_HTTP_URL=http://extractor_agent:13104
# GUI 网页手（Docker Lobster）；桌面手可选 Hands 侧车分端口
LOBSTER_AGENT_WS_URL=ws://lobster_agent:13108/_ws
# LOBSTER_HANDS_WS_URL=ws://host.docker.internal:13109/_ws
# LOBSTER_HANDS_HTTP_URL=http://host.docker.internal:13109
AI_ADMIN_AGENT_WS_URL=ws://ai_admin_agent:13105/api/chat/ws
MULTIMODAL_AGENT_HTTP_URL=http://multimodal_agent:13107
MUSIC_AGENT_WS_URL=ws://music_agent:13110/ws
MUSIC_AGENT_HTTP_URL=http://music_agent:13110
VIDEO_AGENT_WS_URL=ws://video_agent:13111/ws/video
VIDEO_AGENT_HTTP_URL=http://video_agent:13111
AGENT_TIMEOUT_MS=240000
# 本地裸跑：DB_AGENT_WS_URL=ws://localhost:13101/api/chat.ws 等

# ── 运行档位（Docker 调优见 Manage-platform_Agent/.env.agents-lan.example）──
MANAGER_ROUTE_MODE=convergence
MANAGER_PRO_MODE=strong
EVO_MODE=convergence
ARTIFACT_FEEDBACK_MODE=strict
# 0=Planner 始终 LLM；省略或 1=编排蓝图可材料化跳过 Planner LLM
# MANAGER_PLAN_FROM_BLUEPRINT=0
MANAGER_WEB_SEARCH_MODE=open
WEB_SEARCH_PROVIDER=searxng
# Docker 网内：http://searxng:8080；宿主机裸机联调：http://localhost:8088
SEARXNG_BASE_URL=http://searxng:8080
MANAGER_PLATFORM_MODE=sync
# 鉴权：Docker/LAN/公网用 token（须与下方 WS token 成对）；裸机本地可改 open
MANAGER_AUTH_MODE=token
# 浏览器用户登录（ClawHive JWT；userId=JWT.sub）；与上方服务 WS token 正交
MANAGER_USER_AUTH=1
JWT_SECRET=change-this-secret
# 浏览器可达的 ClawHive 后端（登录 POST）；Docker LAN 常用宿主机映射端口
NUXT_PUBLIC_CLAWHIVE_AUTH_URL=http://127.0.0.1:18000
# NUXT_PUBLIC_MANAGER_USER_AUTH=1
# docker=compose 服务名；local=localhost 裸机（与下方 *_URL 一致）
MANAGER_RUNTIME=docker
# MANAGER_ROUTE_DECISION_TIER=plus       # plus | max

# ── GUI（Lobster，可选）──
# MANAGER_GUI_TIMEOUT_FORM_MS=360000

# ── WS / 运维鉴权（AUTH_MODE=token 时必填；与 agents-lan.example 对齐）──
# 未设 AUTH_MODE 时默认不鉴权（本地 smoke）；公网务必 token + TLS
MANAGER_WS_TOKEN=change-internal-token
NUXT_PUBLIC_MANAGER_WS_TOKEN=change-internal-token
# 运维 POST /api/manager/ops（头 x-manager-ops-token）；未设则一律 403
MANAGER_OPS_TOKEN=change-ops-token

# ── 持久化（Docker / 生产；集群叠加见 .env.agents-lan.example）──
# AGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/clawhive
# REDIS_URL=redis://localhost:16379/0
# MANAGER_STORAGE_BACKEND=postgres
# MANAGER_LANGGRAPH_CHECKPOINTER=postgres
# MANAGER_CHECKPOINT_BACKEND=dual

# ── ClawHive（MANAGER_PLATFORM_MODE=sync）──
# CLAWHIVE_BACKEND_URL=http://localhost:18000
# CLAWHIVE_INTERNAL_TOKEN=change-internal-token

# ── LangSmith（可选）──
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=manager-agent

# ── 安全与重试预算（硬上限，防无限重试耗 token）──
# 局部 Observation→Replan 次数/轮；达阈强制回 Plan Mode HITL（clamp 0–5）
MANAGER_LOCAL_REPLAN_MAX=3
# critic/optimizer 整轮 fix 重试（clamp 0–5）
MANAGER_MAX_RETRY=1
# LangGraph 节点递归上限（clamp 25–120）
MANAGER_GRAPH_RECURSION_LIMIT=48
# 多 phase 续跑上限
MANAGER_MAX_RUN_PHASES=3
# 单 phase / 局部 replan 步数预算
MANAGER_PHASE_STEP_BUDGET=8
# 自主队列
MANAGER_AUTONOMOUS_MAX_STEPS=8
MANAGER_AUTONOMOUS_MAX_ATTEMPTS=2
# LLM HTTP 层重试（默认 0=不重试）
MANAGER_LLM_MAX_RETRIES=0
# 同 Agent 连续失败 N 次后熔断（clamp 1–5）
MANAGER_AGENT_CIRCUIT_STREAK=2
# 1=熔断后跳过核心 Agent（db/rag/…），避免 local replan 反复加回空转；0=仅跳过 clean/visualize/report
MANAGER_CIRCUIT_SKIP_CORE=1

# ── B2 Prompt / 上下文硬预算（字符级）──
# MANAGER_PROMPT_BUDGET_RULES_CHARS=2000
# MANAGER_PROMPT_BUDGET_SKILL_CHARS=2500
# MANAGER_OBS_SUMMARY_MAX_CHARS=400
# MANAGER_OBS_KEEP_LAST=4
# MANAGER_HANDOFF_SUMMARY_MAX_CHARS=600

# MODE / 模型 SSOT：Manage-platform_Agent/.env.convergence-modes.example + sync-convergence-modes.py
# 能力模型：Manage-platform_Agent/.env.capability-models + sync-capability-models.py
# 门禁：npm run smoke:env-modes · gate:n4 · gate:e4 · smoke:p3 · scripts/smoke/README.md
