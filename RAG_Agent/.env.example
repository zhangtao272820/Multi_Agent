# =============================================================================
# RAG_Agent — 文档检索问答 Agent
# 复制为 .env 后填写 OPENAI_API_KEY
# 检索行为 → server/utils/rag_agent_env.ts · MODE SSOT → .env.convergence-modes.example
# 能力层模型 → Manage-platform_Agent/.env.capability-models.example
# =============================================================================

# ── 必填：API 密钥 ──
OPENAI_API_KEY=                          # 阿里云百炼 API Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 能力层模型 ──
CONDENSE_MODEL=qwen-flash-2025-07-28           # T0 多轮 condense
QUERY_PLAN_MODEL=qwen-flash-2025-07-28         # T0 检索 query 规划
EXPANSION_MODEL=qwen-flash-2025-07-28          # T0 query 扩展
RAG_EVIDENCE_SELECT_MODEL=qwen-flash-2025-07-28
CHAT_MODEL=qwen-plus-2025-01-25                # T1 最终作答
RERANK_MODEL=gte-rerank-v2
RAG_CROSS_ENCODER_MODEL=gte-rerank-v2
EMBEDDING_MODEL=text-embedding-v3
OCR_MODEL=qwen-vl-ocr

# ── 运行档位 ──
RAG_CORPUS_TIER=auto                     # auto | s | m | l（知识库规模；勿写 standard）
RAG_NLU_MODE=minimal                     # full | minimal | off（独立端默认 minimal：关 intent 补刀，保留 merge）
RAG_UNIFIED_UNDERSTAND=1                 # 独立端一次 JSON 折叠 turn/route/lean_query
EVO_MODE=convergence                     # convergence | learning | off
ARTIFACT_FEEDBACK_MODE=strict            # strict | off（检索偏好学习门控）
QWEN_ENABLE_THINKING=off

# ── 向量存储 ──
RAG_VECTOR_BACKEND=memory                  # memory | pgvector
# RAG_PG_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/rag_vector
# RAG_VECTOR_EXPERIENCE_REQUIRE_USEFUL=1   # 默认仅「有用」反馈写入向量经验；检索成功不自动索引
# EXPERIENCE_RECALL_CONFIRMED_ONLY=1       # 学习信号召回只认有用/显式反馈

# ── 记忆存储 ──
# AGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/clawhive
# RAG_AGENT_STORAGE_BACKEND=postgres       # file | postgres | dual

# ── 高级检索（降成本时可关，见 rag_agent_env.ts）──
# RAG_ENABLE_BM25=on
# RAG_RRF_BM25_WEIGHT=0.85
# RAG_ENABLE_MULTI_QUERY=off              # 复合/多跳时可开；简单事实建议关（控成本）

# ── H 波企业试点默认（代码默认已开；显式写出防「同仓不同命」）──
# RAG_ENABLE_PARENT_CHILD=on             # H2 父子切分
# RAG_PARENT_EXPAND=on                   # H2 检索后 parent 扩展
# RAG_ENABLE_MMR=on                      # H3 去冗余
# RAG_MMR_LAMBDA=0.7                     # λ 大偏相关、小偏多样
# RAG_ENABLE_CITATION_GUARD=on           # H5 答案数字/条款须可在证据核对
# RAG_ENABLE_AGENTIC_RETRIEVAL=on        # H4 弱证据 rewrite
# RAG_CORRECTIVE_MIN_SCORE_GAP=0.015
# RAG_CORRECTIVE_AMBIGUOUS_TOP_MAX=0.22

# ── J/K 波：Agentic 工具环 + MinerU 重解析 ──
# RAG_ENABLE_AGENTIC_TOOL_LOOP=on       # 复杂问句专家内多跳
# RAG_AGENTIC_TOOL_MAX_ROUNDS=4
# RAG_HEAVY_PARSE=on
# MINERU_API_URL=http://127.0.0.1:8798  # Compose: http://mineru_api:8080
# RAG_HEAVY_PARSE_TIMEOUT_MS=120000
# RAG_HEAVY_PARSE_STRICT=off            # 生产 Compose 默认 on；本地无侧车请保持 off
# RAG_HEAVY_PARSE_MIN_CHARS=80          # MinerU 成功但正文过短视为失败
# MINERU_ENGINE=auto                    # auto|full|enhanced|lite（侧车侧）
# RAG_BM25_REBUILD_PAGE=500             # pgvector 倒排冷启动分页

# ── L 波：门控 HyDE + 企业制度 Graph ──
# RAG_ENABLE_HYDE=off                   # 默认关；表达鸿沟门控才开
# RAG_RRF_HYDE_WEIGHT=0.9
# RAG_ENABLE_MULTI_QUERY=off            # 仍默认关；门控在 multi_part/comparison 时才扩
# RAG_ENABLE_POLICY_GRAPH=on            # 制度图双车道（文件 JSON / 同库边表语义）
# RAG_RRF_GRAPH_WEIGHT=1.15
# RAG_POLICY_GRAPH_MAX_HOPS=2
# RAG_POLICY_GRAPH_PATH=                # 可选；默认 .data/rag-policy-graph.json
# RAG_POLICY_GRAPH_BACKEND=auto         # auto|file|pg；auto 在 pgvector 时镜像 PG 边表

# ── ClawHive / 跨 Agent ──
# AGENT_BROWSER_AUTH=1 时必须配置 CLAWHIVE_INTERNAL_TOKEN（与 Manager 同值），
# 否则预取 /api/retrieve、执行 /api/chat 会 401；/api/probe 为公开路径可能掩盖问题。
# CLAWHIVE_BACKEND_URL=http://127.0.0.1:18000
# CLAWHIVE_INTERNAL_TOKEN=
# AGENT_BROWSER_AUTH=1
# JWT_SECRET=change-this-secret
# MANAGER_AGENT_HTTP_URL=http://localhost:13106

# ── 服务端口 ──
PORT=13102
RAG_PORT=13102

# =============================================================================
# LLM-First 生产建议（doc/llm-first-cross-agent-upgrade.md §13.6）
# =============================================================================
RAG_NLU_MODE=minimal                     # catalog LLM 为默认；禁 heuristic merge intent
RAG_UNIFIED_UNDERSTAND=1
RAG_ALLOW_HEURISTIC=0                    # 仅 off 模式 + 显式 1 才允许 heuristic
RAG_INTENT_LLM=1                         # catalog 低置信时 inferRagIntentLlm
RAG_CATALOG_GROUNDED_PLAN=1              # 目录锚定 query plan
# RAG_INTENT_RAG=1                       # playbook 仅 hint，不改 intent
