    "@langchain/langgraph": "^1.2.5",
    "@langchain/openai": "^1.3.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/postcss": "^4.2.2",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "langchain": "^0.3.37",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "word-extractor": "^1.0.4",
    "zod": "^4.3.6"
