    "smoke:pptx": "npx --yes tsx scripts/smoke-pptx.ts",
    "smoke:nlu": "node --experimental-strip-types scripts/smoke-rag-nlu.ts",
    "smoke:prompt-untrusted": "npx --yes tsx scripts/smoke-rag-prompt-untrusted.ts",
    "smoke:stage4": "npx --yes tsx --tsconfig tsconfig.smoke.json scripts/smoke-rag-stage4.ts",
    "smoke:enterprise-h": "npx --yes tsx scripts/smoke-rag-enterprise-h.ts",
    "smoke:agentic-jk": "npx --yes tsx scripts/smoke-rag-agentic-jk.ts",
    "smoke:source-coverage": "npx --yes tsx scripts/smoke-rag-source-coverage.ts",
    "reindex": "npx --yes tsx scripts/reindex-from-store.ts"
