# Vanna_DbAgent — 独立多库 Text2SQL 助手
# 复制为 .env 后填写密钥。不进 Manager 协作。

OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus-2025-07-14
EMBEDDING_MODEL=text-embedding-v1

VANNA_PORT=13121
VANNA_DATA_DIR=.data
VANNA_AUTO_INGEST=true
VANNA_CHECKPOINT_DEFAULT=true
VANNA_SCENE_DETECT=false
VANNA_POLISH=true
VANNA_MAX_LLM_CALLS=2
VANNA_MAX_EMBED_CALLS=1
VANNA_MAX_INGEST_EMBED_CALLS=500
VANNA_MAX_REPAIR_LLM_CALLS=1
VANNA_MAX_ANSWER_LLM_CALLS=1
VANNA_MAX_PROMPT_CHARS=6000
VANNA_MAX_QUESTION_CHARS=400
VANNA_DEFAULT_TENANT=p2026
VANNA_MCP_TOKEN=

# 独立 UI 默认不验服务令牌；切总管后再按集群设 optional/require
AGENT_SERVICE_AUTH=off
AGENT_SERVICE_TOKEN=
# 经验召回用共享 PG；不配则跳过，不抛错
AGENT_DATABASE_URL=
# 禁止专家自动晋级黄金
EVO_ALLOW_EXPERT_AUTO_PROMOTE=false

# 默认租户：与 DB_Agent 同库（本机 MySQL p2026）
# Docker 内 host 用 host.docker.internal；本机脚本用 127.0.0.1
P2026_MYSQL_HOST=host.docker.internal
P2026_MYSQL_PORT=3306
P2026_MYSQL_USER=root
P2026_MYSQL_PASSWORD=123456
P2026_MYSQL_DATABASE=p2026

# 旧租户 P2604（可选保留）
P2604_MYSQL_HOST=192.168.88.99
P2604_MYSQL_PORT=3388
P2604_MYSQL_USER=root
P2604_MYSQL_PASSWORD=
P2604_MYSQL_DATABASE=P2604
